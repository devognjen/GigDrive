# ── Database ───────────────────────────────────────────────
POSTGRES_USER=gigdrive
POSTGRES_PASSWORD=gigdrive
POSTGRES_DB=gigdrive
# Host used by the backend. Inside docker-compose this is the `db` service name;
# for local development against the Dockerized DB use `localhost`.
DB_HOST=db
DB_PORT=5432

# ── Backend ────────────────────────────────────────────────
BACKEND_PORT=3000
# Secret used to sign JWT tokens (feature 02). Generate a long random string.
JWT_SECRET=change-me-in-your-env
# Lifetime of issued JWT access tokens (feature 02), e.g. 1h, 1d, 7d.
JWT_EXPIRES_IN=1d
# Password of the seeded demo driver (seed script / startup seed).
SEED_DEMO_PASSWORD=demo1234
# Set to false to skip the idempotent demo seed on backend startup.
# SEED_ON_START=false

# ── Ticketmaster Discovery API (feature 03) ────────────────
# Free key from https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# ── Open-Meteo (feature 13) ────────────────────────────────
# Optional override; default is https://api.open-meteo.com (no key required).
# OPEN_METEO_BASE_URL=https://api.open-meteo.com

# ── SMTP / Mailtrap (feature 07) ───────────────────────────
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GigDrive <no-reply@gigdrive.local>"

# ── In-app trip chat (feature 10) ───────────────────────────
# Per-trip WebSocket chat for the driver and confirmed passengers.
# Set to false to hide the UI and disable the gateway/history endpoint.
FEATURE_CHAT=true

# ── Signal automation (feature 11, experimental, compose profile `signal`) ─
# Unofficial signal-cli client (ToS gray area; number-restriction risk).
# Email remains the primary channel. No user phone numbers are sent to Signal.
# Start with `docker compose --profile signal up`, register SIGNAL_NUMBER, then
# set FEATURE_SIGNAL=true. Failures never block trip confirmation.
SIGNAL_NUMBER=
SIGNAL_CLI_URL=http://signal-cli:8080
FEATURE_SIGNAL=false

# ── Frontend ───────────────────────────────────────────────
FRONTEND_PORT=4200
# Base URL the browser uses to reach the API. The nginx container proxies
# /api to the backend, so the default works for the compose stack.
API_URL=/api
